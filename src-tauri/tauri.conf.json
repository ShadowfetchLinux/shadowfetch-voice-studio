{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shadowfetch Voice Studio",
  "version": "0.1.1",
  "identifier": "com.shadowfetch.voicestudio",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../frontend", "wait": false },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Shadowfetch Voice Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPCACHE/**", "$APPCONFIG/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Music",
    "shortDescription": "Private, local voice cloning studio",
    "longDescription": "Record or import a voice reference, transcribe it, and generate narration with local text-to-speech engines. Everything stays on this machine.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/app-icon.svg"
    ],
    "resources": {
      "../backend/shadowfetch_worker": "backend/shadowfetch_worker",
      "../backend/requirements": "backend/requirements",
      "../scripts": "scripts",
      "../docs/*.md": "docs"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "ffmpeg",
          "libportaudio2",
          "python3 (>= 3.11)",
          "python3-venv"
        ],
        "section": "sound",
        "priority": "optional",
        "desktopTemplate": "linux/shadowfetch-voice-studio.desktop.hbs",
        "files": {
          "/usr/share/applications/com.shadowfetch.voicestudio.desktop": "linux/com.shadowfetch.voicestudio.desktop"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
